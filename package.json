{
  "name": "@netbird/mcp",
  "version": "0.1.0",
  "description": "MCP server for NetBird — manage peers, setup keys, groups, policies, networks and DNS from Claude. Runs locally (stdio) or in the cloud (streamable HTTP).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "netbird-mcp": "dist/bin/stdio.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin/stdio.js",
    "start:http": "node dist/bin/http.js",
    "dev": "tsx src/bin/stdio.ts",
    "dev:http": "tsx src/bin/http.ts",
    "inspect": "mcp-inspector tsx src/bin/stdio.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.13.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
